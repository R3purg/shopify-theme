<section
  id="value-propositions-{{ section.id }}"
  class="value-propositions {{ section.settings.background }}"
  style="--value-propositions-border: {% if section.settings.show_border %}1px{% else %}0{% endif %};">
  <div class="container">
    <div class="value-propositions-grid" role="list">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a class="value-proposition" href="{{ block.settings.link }}" role="listitem" {{ block.shopify_attributes }}>
        {% else %}
          <div class="value-proposition" role="listitem" {{ block.shopify_attributes }}>
        {% endif %}
            {% render 'svg-icons', icon: block.settings.icon, size: 18, stroke_width: 2, class: 'value-proposition-icon' %}
            <span>{{ block.settings.text }}</span>
        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value propositions",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "value-propositions-surface",
      "options": [
        { "value": "value-propositions-surface", "label": "Soft cream" },
        { "value": "value-propositions-body", "label": "Body" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "proposition",
      "name": "Proposition",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check-circle",
          "options": [
            { "value": "check-circle", "label": "Check" },
            { "value": "truck", "label": "Shipping" },
            { "value": "recently-viewed", "label": "Returns" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $150"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value propositions",
      "blocks": [
        { "type": "proposition" },
        { "type": "proposition", "settings": { "icon": "recently-viewed", "text": "Easy 30-day returns" } },
        { "type": "proposition", "settings": { "icon": "heart", "text": "Premium merino wool" } },
        { "type": "proposition", "settings": { "icon": "check-circle", "text": "Hand-knit in small batches" } }
      ]
    }
  ]
}
{% endschema %}